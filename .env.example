# Copy to .env and adjust. All settings use the STATEASE_ prefix (see backend/app/config.py).

# Required in production: a long random value (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))").
# It signs session tokens and encrypts stored database-connection passwords.
STATEASE_SECRET_KEY=change-me

# password (default) = accounts with email/password and optional Google sign-in.
# local = one local user, no login (offline single-user use only).
STATEASE_AUTH_MODE=password
STATEASE_ALLOW_REGISTRATION=true

# Public address of the app (used for Google redirect URIs and password-reset links).
# In development with the Vite dev server use http://localhost:5173.
STATEASE_PUBLIC_URL=http://localhost:8000

# Google sign-in (OAuth 2.0 "Web application" client from Google Cloud Console).
# Authorised redirect URI to register: <STATEASE_PUBLIC_URL>/api/v1/auth/google/callback
# Leave empty to hide the "Continue with Google" button.
STATEASE_GOOGLE_CLIENT_ID=
STATEASE_GOOGLE_CLIENT_SECRET=

# E-mail for password resets. Without SMTP the reset link is written to the server log.
STATEASE_SMTP_HOST=
STATEASE_SMTP_PORT=587
STATEASE_SMTP_USERNAME=
STATEASE_SMTP_PASSWORD=
STATEASE_SMTP_FROM=StatEase Analytics <no-reply@example.com>

# Metadata database. SQLite by default; PostgreSQL for multi-user deployments.
# STATEASE_DATABASE_URL=postgresql+psycopg://statease:password@localhost:5432/statease
# STATEASE_STORAGE_DIR=/data/storage

# Resource limits
STATEASE_MAX_UPLOAD_MB=512
STATEASE_MAX_EXCEL_MB=100
STATEASE_ANALYSIS_MAX_ROWS=5000000
STATEASE_ANALYSIS_WORKERS=2
STATEASE_SQL_TIMEOUT_SECONDS=30
STATEASE_SQL_MAX_ROWS=10000

# Python console: disabled by default. Read docs/SECURITY.md before enabling.
STATEASE_ENABLE_PYTHON_CONSOLE=false
STATEASE_PYTHON_TIMEOUT_SECONDS=30
STATEASE_PYTHON_MEMORY_MB=1024

# docker compose production profile
POSTGRES_PASSWORD=change-me
PUBLIC_ORIGIN=http://localhost:8000
